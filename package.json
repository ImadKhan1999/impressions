{
  "name": "impressions",
  "version": "1.0.0",
  "private": true,
  "description": "Redirect and device compatibility checker with real-browser testing.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @impressions/web && npm run build -w @impressions/server",
    "start": "node apps/server/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
